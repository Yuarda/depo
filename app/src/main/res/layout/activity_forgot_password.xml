<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#122143"
    android:padding="24dp">

    <!-- Başlık -->
    <TextView
        android:id="@+id/tvResetTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Şifre Sıfırlama"
        android:textSize="32sp"
        android:textStyle="bold"
        android:letterSpacing="0.02"
        android:textColor="#FFFFFF"
        android:textAlignment="center"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.25"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/tvResetSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Açıklama Metni -->
    <TextView
        android:id="@+id/tvResetSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Lütfen kayıtlı kullanıcı adınızı ve yeni şifrenizi girin."
        android:textSize="16sp"
        android:textAlignment="center"
        android:textColor="#A0ABC0"
        app:layout_constraintTop_toBottomOf="@id/tvResetTitle"
        app:layout_constraintBottom_toTopOf="@+id/tilResetUsername"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Kullanıcı Adı Giriş Alanı -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilResetUsername"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:hint="Kullanıcı Adı"
        android:textColorHint="#A0ABC0"
        app:hintTextColor="#FFFFFF"
        app:boxStrokeColor="#FFFFFF"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="2dp"
        app:layout_constraintTop_toBottomOf="@id/tvResetSubtitle"
        app:layout_constraintBottom_toTopOf="@+id/tilResetNewPassword"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etResetUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:inputType="textNoSuggestions" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Yeni Şifre Giriş Alanı -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilResetNewPassword"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Yeni Şifre"
        android:textColorHint="#A0ABC0"
        app:hintTextColor="#FFFFFF"
        app:boxStrokeColor="#FFFFFF"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="2dp"
        app:endIconMode="password_toggle"
        app:endIconTint="#A0ABC0"
        app:layout_constraintTop_toBottomOf="@id/tilResetUsername"
        app:layout_constraintBottom_toTopOf="@+id/btnResetPassword"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etResetNewPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:inputType="textPassword" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Şifre Güncelleme Butonu -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnResetPassword"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/metalik_lacivert"
        android:text="Şifremi Güncelle"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/tilResetNewPassword"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>