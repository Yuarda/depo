<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#122143">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Başlık -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Başarı Analizi"
            android:textSize="32sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="32dp"/>

        <!-- Yazılı İstatistikler (Kart Görünümü) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1A2D5C"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:strokeColor="#3A506B"
            app:strokeWidth="1dp"
            android:layout_marginBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvTotalWords"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Toplam Etkileşim: Yükleniyor..."
                    android:textColor="#A0ABC0"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/tvLearned"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tamamen Öğrenilen: Yükleniyor..."
                    android:textColor="#69F0AE"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/tvInProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Devam Eden: Yükleniyor..."
                    android:textColor="#40C4FF"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/tvStruggling"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zorlanılan: Yükleniyor..."
                    android:textColor="#FF5252"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="16dp"/>

                <!-- İnce Ayırıcı Çizgi -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#3A506B"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:id="@+id/tvSuccessRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Genel Başarı: %0.0"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="20sp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Grafik Başlığı -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kelime Dağılım Grafiği"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <!-- Matplotlib Grafiğinin Geleceği Yer (Özel Kart İçinde) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#0A1128"
            app:cardCornerRadius="16dp"
            app:strokeColor="#3A506B"
            app:strokeWidth="1dp"
            android:layout_marginBottom="32dp">

            <ImageView
                android:id="@+id/ivReportChart"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:scaleType="fitCenter"
                android:padding="8dp"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Analiz Butonu -->

    </LinearLayout>
</ScrollView>