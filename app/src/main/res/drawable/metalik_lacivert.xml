<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Köşeleri yuvarlatmak istersen (opsiyonel) -->
    <corners android:radius="8dp" />

    <!-- Işık yansımasını simüle eden renk geçişi -->
    <gradient
        android:angle="135"
        android:startColor="@color/navy_dark"
        android:centerColor="@color/navy_metallic_shine"
        android:endColor="@color/navy_dark"
        android:type="linear" />

    <!-- İnce bir parlak çerçeve (stroke) metalik hissini artırır -->
    <stroke
        android:width="1dp"
        android:color="#5C6B73" />
</shape>